# /etc/kdp/kdp.env  (chmod 600, owned by the kdp user) — copy and fill in.
# Loaded by the systemd units; do NOT commit a filled-in copy.

# --- Kalshi auth (required for live capture) ------------------------------
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KDP_KALSHI_PRIVATE_KEY_PATH=/etc/kdp/kalshi_private_key.pem

# --- Capture ---------------------------------------------------------------
# Comma-separated tickers (one arg). Override per session by dropping a file at
# /etc/kdp/sessions/<session>.env that re-defines KDP_TICKERS.
KDP_TICKERS=KXCUPMATCH-26JUN121330AAABBB-AAA,KXCUPMATCH-26JUN121330AAABBB-BBB
# Idle seconds before the socket is treated as dead and reconnected.
KDP_IDLE=45

# --- Paths (match the runbook; usually leave as-is) -----------------------
KDP_BIN=/opt/kdp/bin
KDP_DATA_DIR=/var/lib/kdp/data
KDP_PROC_DIR=/var/lib/kdp/processed

# --- Archive to remote storage (rclone) ------------------------------------
# rclone remote:path. REQUIRED - the archive/rawsync scripts refuse to run
# without it. The session name is appended -> <remote>/<session>/...
# For the forward hourly service, nest under a parent to keep the ~8,760
# folders/yr tidy and separate from other trees, e.g.:
#   KDP_RCLONE_REMOTE=remote:kdp/hourly
KDP_RCLONE_REMOTE=remote:kdp
# Explicit rclone config path (avoids $HOME ambiguity under systemd). This file
# holds the Drive OAuth token / service-account ref — it is a SECRET, kept on the
# server only (chmod 600, owner kdp), never committed.
RCLONE_CONFIG=/home/kdp/.config/rclone/rclone.conf
# Back up the raw JSONL (tar.gz) to Drive before pruning. Strongly recommended:
# the raw is the unrecoverable source of truth.
KDP_BACKUP_RAW=1
# Prune local raw after a verified upload. Start at 0 (report-only); set to 1
# once you've watched a few archive cycles succeed.
KDP_PRUNE=0
# Keep this many days of processed Parquet locally as a hot cache (raw is pruned
# per-session; processed is pruned by age).
KDP_HOT_DAYS=7
# Cap rclone's Drive transactions/sec so a per-event upload+verify (~26 strikes x
# several files each) stays under Google Drive's per-minute query quota. 4 is
# safe; raise cautiously if archives lag and you're not hitting 403s.
KDP_RCLONE_TPSLIMIT=4

# --- Health / alerting -----------------------------------------------------
# Any URL that accepts a POST body works (ntfy.sh topic, a Telegram-bot webhook
# relay, Slack incoming webhook, etc.). Leave empty to log-only.
KDP_ALERT_WEBHOOK=
# Alert if free disk on /var/lib/kdp drops below this (GiB).
KDP_DISK_FLOOR_GIB=5
# Push an identical alert to the webhook at most once per this many seconds
# (kdp-health always LOGS every occurrence; only the push is throttled). A
# persistent failure otherwise re-pushes every timer tick -- a single stuck unit
# once produced 186 identical pushes in 24h. The dedup key strips digits, so a
# drifting metric (disk GiB, ages) can't defeat it by changing the number.
KDP_ALERT_THROTTLE_SEC=3600
# Where the per-alert last-sent timestamps live. Created by install.sh owned by
# the kdp user -- kdp-health runs as kdp, so a root-owned dir here would make
# every throttle write fail silently and bring the push spam back.
KDP_ALERT_STATE_DIR=/var/lib/kdp/alert-state

# --- Phase C: forward hourly capture (kdp-hourly.service) ---
KDP_HOURLY_SERIES=KXBTCD
# 0 = capture the WHOLE ladder (~188 strikes) each hour and let the two-sided
# curation keep the ATM trail (recommended for KXBTCD: zero-miss as spot moves,
# no resubscribe). A positive N caps capture to +/-N near-money strikes (a load
# limiter for very large ladders).
KDP_HOURLY_BAND=0
# Settlement grace/poll: shared by settlewatch.sh AND the kdp-hourly in-process
# watcher. The unit passes these as --grace/--poll, so they MUST be set (an empty
# expansion would feed the parser a bare flag); KDP_DATA_DIR is set above (--out).
KDP_SETTLE_GRACE=180         # keep capturing this many seconds after settlement
KDP_SETTLE_POLL=30           # settlement poll interval (s)
# Enable curated auto-prune once trusted (raw still backs up to Drive first):
#   KDP_PRUNE=1

# --- Scheduled event capture (kdp-scheduled.service) -----------------------
# Path to the declarative JSONL schedule (one event per line, series-agnostic).
# Copied from deploy/schedules/ to /etc/kdp/schedules/ by install.sh; point this
# at the active event-set. Switch tournaments by changing this one line.
KDP_SCHEDULE_FILE=/etc/kdp/schedules/example.jsonl
# Minutes before each event's scheduled start to begin capturing (catches the
# toss + pre-match movement). Per-entry `arm_lead_min` overrides this.
KDP_SCHED_ARM_LEAD_MIN=60
# Hard backstop in hours per event (rain delays / overruns). Normal exit is
# settlement; this is the safety cap. Per-entry `max_hours` overrides this.
KDP_SCHED_MAX_HOURS=8
# Each schedule entry also carries a `remote_prefix` (e.g. remote:kdp/cup-2026)
# so each event-set lands in its own storage namespace; passed to kdp-archive.sh.
