# /etc/kdp/universes/<name>.env -- one file per kdp-universe@<name> instance,
# layered over the base /etc/kdp/kdp.env. Copy to crypto.env and edit.

# Comma-separated series this universe captures (required).
# Rollout per runbook-universe.md: soak on KXETHD,KXBTC first; add KXBTCD in
# the 4-5PM ET clash-slot off-window after stopping kdp-hourly (never two
# supervisors on one series).
KDP_UNIVERSE_SERIES=KXETHD,KXBTC

# If the box's base KDP_RCLONE_REMOTE (kdp.env) is series-specific (e.g.
# <remote>:<root>/btc-hourly), the universe namespace would nest inside it.
# This file loads AFTER kdp.env, so pin the universe at the general root here
# without touching other units:
#   KDP_RCLONE_REMOTE=<remote>:<root>

# Optional extra flags, word-split into the command line. Examples:
#   --until 2026-07-14            (windowed tournament instance; bare date = inclusive)
#   --for 14d                     (window relative to launch; resolved absolute at start)
#   --max-units 12
#   --clash-sub off
#   --arm-lead-min 45
KDP_UNIVERSE_EXTRA=
