# Oneshot: archive ONE capture session (%i) immediately — process -> verify ->
# upload to Drive -> opt-in prune. Triggered by the settlement watcher (or the
# scheduled stop) right after a session stops; the nightly kdp-archive.timer is
# the catch-all for anything not archived this way.
[Unit]
Description=kdp archive capture session %i to Google Drive
Documentation=https://github.com/PCeltide/snapevent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kdp
Group=kdp
EnvironmentFile=/etc/kdp/kdp.env
ExecStart=/opt/kdp/bin/kdp-archive.sh %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=3600
