# Oneshot: process settled sessions -> Drive -> (opt-in) prune. Run by the timer.
[Unit]
Description=kdp archive settled capture sessions to Google Drive
Documentation=https://github.com/PCeltide/snapevent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kdp
Group=kdp
EnvironmentFile=/etc/kdp/kdp.env
ExecStart=/opt/kdp/bin/kdp-archive.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=3600
